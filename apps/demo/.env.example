# The deterministic simulator needs no environment variables.
# Copy this file to .env.local, then set all three required values below to
# enable model-backed mode. .env.local is ignored by Git and stays server-side.

# Qwen (Alibaba Cloud Model Studio, mainland China compatible-mode endpoint)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-me
LLM_MODEL=qwen-plus
LLM_STRUCTURED_OUTPUT=json_object

# Optional provider-specific request fields. This example disables thinking for
# Qwen models that expose the enable_thinking switch in compatible mode.
LLM_ADDITIONAL_BODY={"enable_thinking":false}

# OpenAI alternative:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-your-openai-key
# LLM_MODEL=replace-with-a-supported-model
# LLM_STRUCTURED_OUTPUT=json_schema
# LLM_ADDITIONAL_BODY={}
# For GPT-6.1 Sol, use LLM_MODEL=gpt-6.1-sol and:
# LLM_ADDITIONAL_BODY={"reasoning_effort":"low","max_completion_tokens":2048}
# Replace ALL provider fields when switching; do not send an OpenAI key to Qwen.

# LiteLLM alternative:
# LLM_BASE_URL=http://localhost:4000/v1
# LLM_API_KEY=replace-with-your-litellm-key
# LLM_MODEL=proactive-planner
